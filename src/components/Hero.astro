---
import { ArrowDown, ArrowUpRight, FileText } from "@lucide/astro";
import { Image } from "astro:assets";
import portrait from "../assets/aman-portrait.jpg";
import { links } from "../data/links";
---
<section id="top" class="hero">
  <div class="shell hero-content">
    <Image src={portrait} alt="Portrait of Aman Krishna Thakur" widths={[280, 560]} sizes="(max-width: 767px) 88px, (max-width: 1023px) 200px, 280px" width={280} height={350} class="hero-portrait" loading="eager" fetchpriority="high" />
    <div class="hero-status"><span class="status-square" aria-hidden="true"></span> Open to junior engineering roles</div>
    <p class="hero-kicker">Full Stack Developer / Complyr</p>
    <h1>Aman Krishna <span>Thakur.</span></h1>
    <p class="hero-intro">Building production web applications,<br />from interface to API.</p>
    <p class="hero-summary">I'm a Full Stack Developer Intern at Complyr. I work across React interfaces, TypeScript application logic, APIs, and cloud services for a GRC fintech application.</p>
    <div class="actions">
      <a href="#projects" class="button button-primary">Explore selected work <ArrowDown size={16} strokeWidth={1.6} /></a>
      <a href={links.resume} target="_blank" rel="noopener noreferrer" class="button"><FileText size={16} strokeWidth={1.6} /> Resume</a>
      <a href={links.linkedin} target="_blank" rel="noopener noreferrer" class="button">LinkedIn <ArrowUpRight size={16} strokeWidth={1.6} /></a>
    </div>
    <dl class="hero-meta">
      <div><dt>Current work</dt><dd>Complyr / Oct 2025 - Present</dd></div>
      <div><dt>Core stack</dt><dd>React, TypeScript, Node.js, PostgreSQL</dd></div>
      <div><dt>Education</dt><dd>B.Sc. / Chandigarh University</dd></div>
    </dl>
  </div>
</section>
