---
import { ArrowUpRight, CodeXml, Mail } from "@lucide/astro";
import { links } from "../data/links";
---
<section id="contact" class="section">
  <div class="shell section-layout">
    <div class="section-head"><p class="eyebrow"><span class="index">06 //</span> Contact</p><h2>Let's connect.</h2></div>
    <div class="contact-content">
      <h3>Let's build something useful.</h3>
      <p class="copy">I'm open to junior software engineering opportunities, including remote roles.</p>
      <div class="actions">
        <a href={links.email} class="button button-primary"><Mail size={16} /> Email me</a>
        <a href={links.linkedin} target="_blank" rel="noopener noreferrer" class="button">LinkedIn <ArrowUpRight size={16} /></a>
        <a href={links.github} target="_blank" rel="noopener noreferrer" class="button"><CodeXml size={16} /> GitHub</a>
      </div>
    </div>
  </div>
</section>
