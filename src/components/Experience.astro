---
import { ArrowRight } from "@lucide/astro";
import { experience } from "../data/experience";
---
<section id="experience" class="section">
  <div class="shell section-layout">
    <div class="section-head"><p class="eyebrow"><span class="index">01 //</span> Experience</p><h2>Commercial experience.</h2><p class="copy section-description">Contributing to a production application across the interface, APIs, and cloud services.</p></div>
    <div>
      {experience.map((job) => (
        <article class="experience-entry">
          <div class="job-header">
            <div><h3>{job.role}</h3><p class="job-company">{job.company}</p></div>
            <p class="job-date">{job.period}<br />GRC / Compliance Fintech</p>
          </div>
          <ul class="job-points">{job.highlights.map((point) => <li><ArrowRight size={15} strokeWidth={1.5} /><span>{point}</span></li>)}</ul>
          <div class="tags">{["React", "TypeScript", "Node.js", "PostgreSQL", "AWS"].map((tool) => <span>{tool}</span>)}</div>
        </article>
      ))}
    </div>
  </div>
</section>
