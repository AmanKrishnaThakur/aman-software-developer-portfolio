---
import { experience } from "../data/experience";
---
<section id="experience" class="section border-b border-line bg-white">
  <div class="shell">
    <p class="eyebrow">01 / Experience</p>
    <h2 class="section-title mt-3">Engineering in production</h2>
    <div class="mt-10 border-l-2 border-teal/25 pl-6 sm:pl-8">
      {experience.map((job, index) => (
        <article class:list={["relative", index > 0 && "mt-10 border-t border-line pt-9"]}>
          <span class="absolute -left-[33px] top-1 h-3 w-3 rounded-full border-[3px] border-white bg-teal sm:-left-[41px]"></span>
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <div><h3 class="text-xl font-bold text-ink">{job.role}</h3><p class="mt-1 font-semibold text-teal">{job.company} <span class="font-normal text-muted">/ {job.location}</span></p></div>
            <p class="font-mono text-xs text-muted">{job.period}</p>
          </div>
          <ul class="mt-5 grid gap-3 text-sm leading-6 text-muted sm:text-base">
            {job.highlights.map((point) => <li class="flex gap-3"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-teal"></span><span>{point}</span></li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
