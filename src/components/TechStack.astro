---
import { skillGroups, otherSkills } from "../data/skills";
---
<section id="stack" class="section border-b border-line bg-white">
  <div class="shell">
    <p class="eyebrow">03 / Toolkit</p>
    <h2 class="section-title mt-3">Technology I work with</h2>
    <div class="mt-9 grid gap-x-8 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
      {skillGroups.map((group) => (
        <div class="border-t-2 border-teal pt-5">
          <h3 class="text-sm font-bold text-ink">{group.title}</h3>
          <div class="mt-4 flex flex-wrap gap-2">{group.skills.map((skill) => <span class="rounded border border-line bg-paper px-2.5 py-1.5 text-xs text-ink">{skill}</span>)}</div>
        </div>
      ))}
    </div>
    <p class="mt-9 text-xs text-muted">Other experience: {otherSkills.join(" · ")}</p>
  </div>
</section>
