---
import { CodeXml, Braces, Database, Cloud, Wrench } from "@lucide/astro";
import { skillGroups, otherSkills } from "../data/skills";
const icons = [CodeXml, Braces, Database, Cloud, Wrench];
---
<section id="stack" class="section work-section">
  <div class="shell">
    <div class="section-head">
      <div><p class="eyebrow"><span class="index">03 //</span> Stack</p><h2>Technical stack.</h2></div>
      <p class="copy">Tools I use across interfaces,<br class="hidden md:block" /> application logic, and deployment.</p>
    </div>
    <div class="stack-grid">
      {skillGroups.map((group, index) => {
        const Icon = icons[index];
        return <article class="stack-card">
          <h3><Icon size={19} strokeWidth={1.5} />{group.title}</h3>
          <ul class="skill-items">{group.skills.map((skill) => <li>{skill}</li>)}</ul>
        </article>;
      })}
    </div>
    <p class="other-skills">Other experience: {otherSkills.join(" / ")}</p>
  </div>
</section>
