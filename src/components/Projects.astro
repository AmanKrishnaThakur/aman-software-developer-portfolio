---
import { ArrowUpRight, Clapperboard, CloudSun, Gamepad2 } from "@lucide/astro";
import { featuredProject, personalProjects, moreProjects } from "../data/projects";
const projectIcons = [Clapperboard, CloudSun, Gamepad2];
---
<section id="projects" class="section work-section">
  <div class="shell">
    <div class="section-head">
      <div><p class="eyebrow"><span class="index">02 //</span> Selected work</p><h2>Selected projects.</h2></div>
      <p class="copy">Production work, followed by personal projects<br class="hidden md:block" /> in JavaScript and the browser.</p>
    </div>
    <article class="professional-work">
      <div>
        <p class="eyebrow">{featuredProject.status} / Complyr</p>
        <h3>{featuredProject.title}</h3>
        <p class="copy">{featuredProject.description}</p>
        <div class="tags">{featuredProject.stack.map((item) => <span>{item}</span>)}</div>
      </div>
      <a href={featuredProject.href} class="text-link">{featuredProject.cta} <ArrowUpRight size={15} /></a>
    </article>
    <div class="project-grid">
      {personalProjects.map((project, index) => {
        const Icon = projectIcons[index];
        return (
          <article class="project-card">
            <div class="project-card-top"><Icon size={25} strokeWidth={1.4} /><span>{String(index + 1).padStart(2, "0")}</span></div>
            <p class="project-category">{project.category}</p>
            <h4>{project.title}</h4>
            <p class="copy">{project.description}</p>
            <div class="tags">{project.stack.map((item) => <span>{item}</span>)}</div>
            <p class="project-state"><span class:list={["status-square", { "status-progress": project.status === "In Progress" }]} aria-hidden="true"></span>{project.status}</p>
          </article>
        );
      })}
    </div>
    <h3 class="secondary-title">More JavaScript projects</h3>
    <div class="secondary-grid">
      {moreProjects.map((project) => <article class="secondary-project"><h4>{project.title}</h4><p class="copy">{project.description}</p></article>)}
    </div>
  </div>
</section>
