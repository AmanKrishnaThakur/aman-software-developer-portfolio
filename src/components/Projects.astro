---
import { featuredProject, personalProjects } from "../data/projects";
---
<section id="projects" class="section border-b border-line bg-paper">
  <div class="shell">
    <p class="eyebrow">02 / Selected work</p>
    <h2 class="section-title mt-3">Projects & engineering work</h2>
    <p class="mt-4 max-w-2xl text-muted">Production experience alongside smaller projects built to practice core browser and JavaScript skills.</p>
    <article class="mt-9 grid overflow-hidden rounded border border-line bg-white md:grid-cols-[1fr_0.9fr]">
      <div class="p-6 sm:p-9">
        <p class="font-mono text-xs font-bold uppercase text-teal">{featuredProject.status}</p>
        <h3 class="mt-3 text-2xl font-bold text-ink">{featuredProject.title}</h3>
        <p class="mt-2 text-sm font-medium text-muted">{featuredProject.category}</p>
        <p class="mt-5 max-w-xl text-sm leading-7 text-muted">{featuredProject.description}</p>
        <div class="mt-5 flex flex-wrap gap-2">{featuredProject.stack.map((item) => <span class="rounded bg-paper px-2.5 py-1 font-mono text-xs text-ink">{item}</span>)}</div>
        <a href={featuredProject.href} class="mt-7 inline-flex text-sm font-bold text-teal hover:underline">{featuredProject.cta} <span class="ml-2" aria-hidden="true">→</span></a>
      </div>
      <div class="flex min-h-[240px] items-center justify-center bg-dark px-6 py-10 text-white" aria-hidden="true">
        <div class="w-full max-w-[330px] rounded border border-white/20 bg-white/5 p-5 font-mono text-[11px] sm:text-xs">
          <div class="mb-5 flex gap-1.5"><span class="h-2 w-2 rounded-full bg-rose-400"></span><span class="h-2 w-2 rounded-full bg-amber-300"></span><span class="h-2 w-2 rounded-full bg-accent"></span></div>
          <div class="space-y-3 text-slate-300"><div class="flex justify-between"><span>auth / RBAC</span><span class="text-accent">active</span></div><div class="h-px bg-white/15"></div><div class="flex justify-between"><span>rules engine</span><span class="text-accent">active</span></div><div class="h-px bg-white/15"></div><div class="flex justify-between"><span>workflow tasks</span><span class="text-accent">active</span></div><div class="h-px bg-white/15"></div><div class="flex justify-between"><span>invoice OCR</span><span class="text-accent">active</span></div></div>
        </div>
      </div>
    </article>
    <div class="mt-10 flex flex-wrap items-baseline justify-between gap-3">
      <h3 class="text-xl font-bold">Personal projects</h3>
      <p class="text-xs text-muted">Local learning projects; source and demos are not published yet.</p>
    </div>
    <div class="mt-5 grid gap-4 md:grid-cols-3">
      {personalProjects.map((project, index) => (
        <article class="flex min-h-[260px] flex-col rounded border border-line bg-white p-6">
          <div class="mb-6 flex items-start justify-between gap-3"><span class="font-mono text-xs text-teal">0{index + 1} / {project.category}</span><span class="text-xs text-muted">{project.status}</span></div>
          <h4 class="text-lg font-bold text-ink">{project.title}</h4>
          <p class="mt-3 flex-1 text-sm leading-6 text-muted">{project.description}</p>
          <div class="mt-6 flex flex-wrap gap-2">{project.stack.map((item) => <span class="rounded bg-paper px-2 py-1 font-mono text-[11px] text-ink">{item}</span>)}</div>
        </article>
      ))}
    </div>
  </div>
</section>
