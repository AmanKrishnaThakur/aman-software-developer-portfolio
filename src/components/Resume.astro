---
import { ArrowUpRight, Download } from "@lucide/astro";
import { links } from "../data/links";
---
<section id="resume" class="section">
  <div class="shell section-layout">
    <div class="section-head"><p class="eyebrow"><span class="index">05 //</span> Resume</p><h2>Experience at a glance.</h2></div>
    <div class="resume-content">
      <p class="copy">Experience, selected projects,<br />and education in one place.</p>
      <div class="actions">
        <a href={links.resume} target="_blank" rel="noopener noreferrer" class="button">View resume <ArrowUpRight size={16} /></a>
        <a href={links.resume} download="Aman-Krishna-Thakur-Resume.pdf" class="button button-primary"><Download size={16} /> Download PDF</a>
      </div>
    </div>
  </div>
</section>
